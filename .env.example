# Copy this file to ".env" and fill in the real values.
# Never commit the real ".env" file. It holds secrets.

# --- Google login + calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MeetStream (the meeting bot service) ---
MEETSTREAM_API_KEY=
MEETSTREAM_WEBHOOK_SECRET=

# --- Google Gemini (the AI) ---
GEMINI_API_KEY=

# --- Database (Postgres, e.g. Neon or Vercel Postgres) ---
DATABASE_URL=

# --- Your app's public web address ---
# In development this is http://localhost:3000
# MeetStream sends webhooks to APP_BASE_URL + "/api/webhooks/meetstream".
APP_BASE_URL=http://localhost:3000
